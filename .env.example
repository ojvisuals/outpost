# Which verification provider the app uses. "mock" is the only one that works in this prototype.
VITE_VERIFICATION_PROVIDER=mock

# Future: base URL of the Scana backend. This is a public URL only.
# NEVER put GS1 or NAFDAC credentials in a VITE_ variable: they would ship to the browser.
# VITE_SCANA_API_URL=https://api.example.com
